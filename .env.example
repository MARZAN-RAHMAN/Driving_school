# Environment configuration template for NextDrive Driving School Platform

# Database (PostgreSQL / Supabase / Neon / RDS)
DATABASE_URL=

# Environment & Server
NODE_ENV=production
PORT=3000

# Authentication & Session Security (Generate a strong random string)
SESSION_SECRET=
AUTH_SECRET=

# Optional Stripe Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API Key (Must be restricted by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Social Authentication Providers (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=
