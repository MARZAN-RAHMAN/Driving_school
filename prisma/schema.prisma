// NexusCore Database Architecture
// Compatible with PostgreSQL, SQLite, and MySQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
  USER
  EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String?
  role         Role          @default(USER)
  status       UserStatus    @default(ACTIVE)
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLogin    DateTime?
  
  contentItems ContentItem[]
  auditLogs    AuditLog[]
  accounts     Account[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ContentItem {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  category    String
  excerpt     String
  content     String
  status      ContentStatus @default(DRAFT)
  views       Int           @default(0)
  readTime    String        @default("4 min read")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([status])
  @@index([category])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actorEmail  String
  target      String
  ip          String   @default("127.0.0.1")
  severity    String   @default("INFO")
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}

model SystemMetric {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  value       String
  change      String
  changeType  String   // positive, negative, neutral
  description String
  updatedAt   DateTime @updatedAt
}

model PopupCampaign {
  id                    String                @id @default("popup_main")
  name                  String                @default("Book Your Driving Lesson")
  isEnabled             Boolean               @default(true)
  status                String                @default("PUBLISHED")
  
  title                 String                @default("Ready to Start Driving?")
  subtitle              String                @default("Book your first lesson with NextDrive Academy.")
  description           String                @default("Tell us a little about yourself and our DVSA Grade A team will match you with a top-rated local instructor.")
  buttonText            String                @default("Book My Lesson")
  successTitle          String                @default("Lesson Request Received!")
  successMessage        String                @default("Thank you! Your request has been received. Our senior dispatch team will review instructor schedules and contact you shortly.")
  trustBadgeText        String?               @default("✓ 89.4% First-Time Pass Rate • Modern Dual-Control Fleet • Grade A Instructors")
  afterSubmissionAction String                @default("show_success")
  customRedirectUrl     String?

  triggerType           String                @default("time")
  delaySeconds          Int                   @default(10)
  mobileDelaySeconds    Int                   @default(15)
  scrollPercentage      Int                   @default(50)
  showCountdown         Boolean               @default(false)

  frequency             String                @default("once_per_session")
  dismissalRule         String                @default("cooldown_days")
  cooldownDays          Int                   @default(7)

  showDesktop           Boolean               @default(true)
  showTablet            Boolean               @default(true)
  showMobile            Boolean               @default(true)
  targetPages           String[]              @default(["/", "/#courses", "/#locations"])
  excludedPages         String[]              @default(["/admin", "/instructor", "/student", "/login", "/signup", "/auth"])

  position              String                @default("center")
  size                  String                @default("medium")
  theme                 String                @default("auto")
  animation             String                @default("fade_scale")
  animationDurationMs   Int                   @default(300)
  backdropEnabled       Boolean               @default(true)
  backdropOpacity       Int                   @default(40)

  fields                PopupField[]
  analyticsEvents       PopupAnalyticsEvent[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  publishedAt           DateTime?
}

model PopupField {
  id                    String        @id @default(uuid())
  popupId               String
  popup                 PopupCampaign @relation(fields: [popupId], references: [id], onDelete: Cascade)
  fieldKey              String
  label                 String
  placeholder           String?
  fieldType             String        @default("text")
  options               String[]      @default([])
  isEnabled             Boolean       @default(true)
  isRequired            Boolean       @default(false)
  displayOrder          Int           @default(0)

  @@index([popupId])
  @@index([displayOrder])
}

model PopupAnalyticsEvent {
  id                    String        @id @default(uuid())
  popupId               String
  popup                 PopupCampaign @relation(fields: [popupId], references: [id], onDelete: Cascade)
  event                 String
  pageUrl               String        @default("/")
  deviceType            String        @default("desktop")
  timestamp             DateTime      @default(now())

  @@index([popupId])
  @@index([event])
  @@index([timestamp])
}
